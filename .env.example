# Banco PostgreSQL (Supabase). No painel do Supabase: Connect > ORMs > Prisma.
# Conexão via pooler (porta 6543), usada pelo sistema:
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432), usada para criar/atualizar as tabelas:
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Chave secreta dos logins. Gere uma com: openssl rand -base64 32
AUTH_SECRET="troque-esta-chave-por-uma-aleatoria"

# Senha da área /admin, onde você cadastra as saloes clientes.
ADMIN_SENHA="troque-esta-senha"

# Pagamentos online (Asaas). Chave da SUA conta principal no Asaas.
# Comece com uma chave do sandbox (https://sandbox.asaas.com) e ASAAS_AMBIENTE=sandbox.
ASAAS_API_KEY=""
ASAAS_AMBIENTE="sandbox" # troque para "producao" quando for receber de verdade

# Protege a rota do cron (/api/cron/lembretes). Sem ela, a rota só manda lembretes e NÃO faz saques automáticos.
# Gere com: openssl rand -hex 32  (a Vercel envia sozinha no cabeçalho Authorization)
CRON_SECRET=""

# Só ao TROCAR o AUTH_SECRET: coloque aqui o valor antigo por alguns dias. O sistema continua lendo as chaves
# cifradas com ele (e recifra com o novo no cron) e aceita os webhooks do Asaas configurados com o token antigo.
AUTH_SECRET_ANTERIOR=""
